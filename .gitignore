backend/.env
backend/.env.*
!backend/.env.example

# Common secret / key material
*.pem
*.key
*.p12
*.pfx
*.crt
!*.example.pem
secrets/
credentials/
credentials.json
service-account*.json
*-credentials.json
*.secret
*.secrets
.secrets/

# Mux / Paystack / cloud key dumps (if ever saved as files)
paystack*.json
mux*.json
*.keystore

