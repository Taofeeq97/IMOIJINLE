# Django API — build from monorepo root: docker build -f infra/Dockerfile.api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

COPY backend/ /app/

RUN uv sync --no-dev || uv sync

EXPOSE 8000

# Production: swap to gunicorn (see config.wsgi). Dev compose may override CMD.
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
# CMD ["uv", "run", "gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
